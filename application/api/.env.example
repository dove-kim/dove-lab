# API 서버 환경변수 예시
# 복사 후 실제 값을 채워서 사용:  cp .env.example .env
# .env 파일은 .gitignore에 의해 커밋되지 않습니다.

# ── 서버 ──────────────────────────────────────────────
SERVER_PORT=8081

# ── 데이터베이스 (MySQL) ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USERNAME=
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# ── JWT ───────────────────────────────────────────────
# 운영 환경에서는 반드시 32자 이상 무작위 문자열로 변경하세요.
# 생성 예시: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ── 초기 ROOT 계정 (최초 기동 1회) ────────────────────
# 계정 생성 후 환경변수 제거를 권장합니다.
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=
