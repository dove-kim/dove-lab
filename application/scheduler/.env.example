# 스케줄러 환경변수 예시
# 복사 후 실제 값을 채워서 사용:  cp .env.example .env
# .env 파일은 .gitignore에 의해 커밋되지 않습니다.

# ── 데이터베이스 (MySQL) ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USERNAME=
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# ── KIS Open API ──────────────────────────────────────
# https://apiportal.koreainvestment.com 에서 발급
# 외부에 절대 노출하지 마세요. 노출 시 즉시 재발급하세요.
KIS_APP_KEY=
KIS_APP_SECRET=

# ── KRX Open API ──────────────────────────────────────
# https://data.krx.co.kr 에서 발급
KRX_API_AUTH_KEY=
KRX_DAILY_QUOTA=6000

# ── 수집 설정 ──────────────────────────────────────────
# 주가 백필 시작일 (기본값: 1985-10-05, KIS 데이터 시작일)
KIS_DATA_START_DATE=1985-10-05
MARKET_INITIAL_DATE=2010-01-01
