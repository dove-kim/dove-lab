# 운영용 docker-compose 예시.
# 파일 복사 후 <...> 자리에 실제 값을 채워서 사용한다.
# 이 파일 자체는 커밋되지만, 복사본(docker-compose.prod.yml)은 .gitignore에 의해 커밋되지 않는다.

services:
  scheduler:
    image: ghcr.io/dove-kim/dove-lab/scheduler:latest
    container_name: scheduler
    restart: unless-stopped
    mem_limit: 1536m
    memswap_limit: 1536m
    environment:
      # DB
      DB_HOST: <DB 호스트>
      DB_PORT: <DB 포트>
      DB_USERNAME: <DB 사용자명>
      DB_PASSWORD: <DB 비밀번호>
      # Redis
      REDIS_HOST: <Redis 호스트>
      REDIS_PORT: <Redis 포트>
      # KRX API
      KRX_API_AUTH_KEY: <한국거래소 API 인증키>
      KRX_DAILY_QUOTA: "6000"
      MARKET_INITIAL_DATE: "2010-01-01"
      # KIS API  ← 절대 커밋 금지
      KIS_APP_KEY: <KIS 앱 키>
      KIS_APP_SECRET: <KIS 앱 시크릿>
      # DART OpenAPI (재무제표 수집)  ← 절대 커밋 금지
      DART_API_KEY: <DART OpenAPI 인증키>
      DART_DAILY_QUOTA: "18000"
      # 임시 작업파일 루트 (DART 원본 zip·ML 아티팩트 — 기동/작업 전후 자동 정리). 컨테이너 내부 경로.
      DOVE_WORK_DIR: /app/work
    volumes:
      - ./logs/scheduler:/logs
    network_mode: "host"

  api:
    image: ghcr.io/dove-kim/dove-lab/api:latest
    container_name: api
    restart: unless-stopped
    mem_limit: 1024m
    memswap_limit: 1024m
    environment:
      SERVER_PORT: ${API_PORT:-8081}
      # DB
      DB_HOST: <DB 호스트>
      DB_PORT: <DB 포트>
      DB_USERNAME: <DB 사용자명>
      DB_PASSWORD: <DB 비밀번호>
      # Redis
      REDIS_HOST: <Redis 호스트>
      REDIS_PORT: <Redis 포트>
      # JWT  ← 반드시 32자 이상 무작위 문자열로 변경
      JWT_SECRET: <JWT 서명 키>
      JWT_ACCESS_EXPIRATION_MS: "900000"
      JWT_REFRESH_EXPIRATION_MS: "2592000000"
      # 최초 ROOT 계정 (초기 기동 1회 후 환경변수 제거 권장)
      INIT_ADMIN_USERNAME: <최초 ROOT 계정 아이디>
      INIT_ADMIN_PASSWORD: <최초 ROOT 계정 비밀번호>
    volumes:
      - ./logs/api:/logs
    network_mode: "host"

  web:
    image: ghcr.io/dove-kim/dove-lab/web:latest
    container_name: web
    restart: unless-stopped
    mem_limit: 768m
    memswap_limit: 768m
    environment:
      PORT: ${WEB_PORT:-3000}
      INTERNAL_API_URL: http://localhost:${API_PORT:-8081}
    network_mode: "host"
